{
  "name": "@beastmode/ui",
  "version": "0.1.0",
  "private": true,
  "description": "The shared BeastMode fleet design system: one look across every BeastMode app.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "assets"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs"
    },
    "./tokens.json": "./dist/tokens.json",
    "./vars.css": "./dist/vars.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup && npm run emit",
    "emit": "tsx src/emit/run.ts",
    "preview": "tsx preview/build.tsx",
    "preview:shots": "npm run preview && node preview/shoot.mjs",
    "preview:verify": "npm run preview && node preview/verify.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@ant-design/cssinjs": "^1.21.0 || ^2.0.0",
    "antd": ">=5.18.0 <7",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "antd": {
      "optional": false
    },
    "react": {
      "optional": false
    },
    "react-dom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@ant-design/cssinjs": "^1.24.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "antd": "^5.26.0",
    "puppeteer-core": "^25.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vitest": "^4.0.13"
  },
  "engines": {
    "node": ">=20"
  }
}
